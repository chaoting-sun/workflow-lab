# Connection strings
DATABASE_URL=postgres://workflow:workflow@localhost:5432/workflow_lab
REDIS_URL=redis://localhost:6379
ARTIFACTS_DIR=./artifacts

# Slot pools (SPEC §7)
GLOBAL_CPU_SLOTS=20
GLOBAL_SSH_SLOTS=40
GLOBAL_TRAINING_SLOTS=4

# Worker sleep durations
CPU_SLEEP_MIN_MS=3000
CPU_SLEEP_MAX_MS=5000
SSH_SLEEP_MS=1000
TRAINING_SLEEP_MS=5000

# Job shape (snapshotted onto jobs.pipelines_count at creation; range 1..1000)
PIPELINES_PER_JOB=200
SCHEDULER_TICK_MS=1000

# Lease / heartbeat — TTL must be a comfortable multiple of the heartbeat interval
LEASE_TTL_MS=30000
LEASE_HEARTBEAT_MS=5000

# Per-kind timeouts (Promise.race in worker)
CPU_TIMEOUT_MS=15000
SSH_TIMEOUT_MS=5000
TRAINING_TIMEOUT_MS=60000

# BullMQ lock duration — must be >= max(*_TIMEOUT_MS) + 5000 (SPEC §3.10)
BULLMQ_LOCK_DURATION_MS=70000

# Retries
MAX_ATTEMPTS=3

# Backpressure (CPU paused when SSH backlog exceeds this)
SSH_BACKPRESSURE_THRESHOLD=80

# Chaos knobs (default 0 = off)
CHAOS_CPU_CRASH_RATE=0
CHAOS_SSH_TIMEOUT_RATE=0
CHAOS_SSH_MISSING_ARTIFACT_RATE=0
