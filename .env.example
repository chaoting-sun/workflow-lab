# Connection strings
DATABASE_URL=postgres://workflow:workflow@localhost:5432/workflow_lab
REDIS_URL=redis://localhost:6379
ARTIFACTS_DIR=./artifacts

# Slot pools (SPEC §7).
# CPU + SSH default to 4 to match the deployed pm2 layout: 4× worker:cpu
# (cpuReplicas tracks GLOBAL_CPU_SLOTS in ecosystem.config.cjs) + 4× worker:io
# with one in-process SSH each, giving "1 process saturates 1 slot" symmetry.
GLOBAL_CPU_SLOTS=4
GLOBAL_SSH_SLOTS=4
GLOBAL_TRAINING_SLOTS=4

# pm2 supervisor: number of io worker replicas (cpu replicas come from
# GLOBAL_CPU_SLOTS via ecosystem.config.cjs).
IO_WORKER_REPLICAS=4

# Worker sleep durations
CPU_SLEEP_MIN_MS=3000
CPU_SLEEP_MAX_MS=5000
SSH_SLEEP_MS=1000
TRAINING_SLEEP_MS=5000

# Job shape (snapshotted onto jobs.pipelines_count at creation; range 1..1000)
PIPELINES_PER_JOB=200
SCHEDULER_TICK_MS=1000

# Lease / heartbeat — TTL must be a comfortable multiple of the heartbeat interval
LEASE_TTL_MS=30000
LEASE_HEARTBEAT_MS=5000

# Per-kind timeouts (Promise.race in worker)
CPU_TIMEOUT_MS=15000
SSH_TIMEOUT_MS=5000
TRAINING_TIMEOUT_MS=60000

# BullMQ lock duration — must be >= max(*_TIMEOUT_MS) + 5000 (SPEC §3.10)
BULLMQ_LOCK_DURATION_MS=70000

# Per-kind BullMQ worker concurrency (in-flight jobs per Worker instance).
# Effective parallelism is still capped by GLOBAL_*_SLOTS in the scheduler.
# IMPORTANT: in single-worker dev mode, *_WORKER_CONCURRENCY must be >=
# the corresponding GLOBAL_*_SLOTS, otherwise dispatched leases expire while
# waiting in Redis for a free in-process slot (replan-log 2026-05-06).
# Under pm2: cpu role overrides CPU_WORKER_CONCURRENCY=1 per replica;
# io role runs SSH_WORKER_CONCURRENCY in-process per replica (4 replicas × 1 = 4 SSH slots).
CPU_WORKER_CONCURRENCY=4
SSH_WORKER_CONCURRENCY=1
TRAINING_WORKER_CONCURRENCY=4

# Retries
MAX_ATTEMPTS=3

# Backpressure (CPU paused when SSH backlog exceeds this; SPEC §3.8 default = 2× SSH slots)
SSH_BACKPRESSURE_THRESHOLD=8

# Chaos knobs (default 0 = off)
CHAOS_CPU_CRASH_RATE=0
CHAOS_SSH_TIMEOUT_RATE=0
CHAOS_SSH_MISSING_ARTIFACT_RATE=0
