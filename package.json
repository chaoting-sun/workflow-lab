{
  "name": "workflow-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "scheduler": "tsx --env-file=.env scheduler/index.ts",
    "worker:cpu": "WORKER_ROLE=cpu tsx --env-file=.env worker/index.ts",
    "worker:io": "WORKER_ROLE=io tsx --env-file=.env worker/index.ts",
    "worker:cpu:watch": "trap 'exit 0' INT TERM; until WORKER_ROLE=cpu tsx --env-file=.env worker/index.ts; do echo '[worker:cpu:watch] worker exited non-zero, restarting in 1s'; sleep 1; done",
    "worker:io:watch": "trap 'exit 0' INT TERM; until WORKER_ROLE=io tsx --env-file=.env worker/index.ts; do echo '[worker:io:watch] worker exited non-zero, restarting in 1s'; sleep 1; done",
    "supervisor:start": "pm2-runtime start ecosystem.config.cjs",
    "supervisor:start:bg": "pm2 start ecosystem.config.cjs",
    "supervisor:stop": "pm2 stop ecosystem.config.cjs",
    "supervisor:delete": "pm2 delete ecosystem.config.cjs",
    "supervisor:logs": "pm2 logs",
    "supervisor:status": "pm2 status",
    "db:reset": "docker compose exec -T postgres psql -U workflow -d workflow_lab -f /docker-entrypoint-initdb.d/01-schema.sql"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "pg": "^8.13.1",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "pm2": "^5.4.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@9.15.3"
}
